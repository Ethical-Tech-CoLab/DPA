{
  "name": "dpa",
  "version": "0.4.0",
  "private": true,
  "description": "Digital Passport for Artworks — v0.4 consolidation monorepo",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r --filter=./packages/** build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "fixtures": "pnpm --filter @dpa/fixtures-build generate",
    "dev": "pnpm --filter @dpa/web dev",
    "build:web": "pnpm --filter @dpa/web build",
    "agent": "pnpm --filter @dpa/agent start",
    "api": "pnpm --filter @dpa/api start"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3",
    "tsx": "^4.19.1"
  }
}
